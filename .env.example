# Copy to .env and fill in. Never commit the real file.
SARVAM_API_KEY=

# Verify these against the event account before depending on them.
SARVAM_ASR_MODEL=saaras:v3
# ASR mode: transcribe (default) | verbatim | codemix | translit | translate
SARVAM_ASR_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
# bulbul:v3 speakers: priya, ritu, neha, pooja, simran, kavya (female);
#                     aditya, ashutosh, rahul, rohan, amit, dev (male).
SARVAM_TTS_SPEAKER=priya
# Pace < 1.0 = slower speech. Therapy default is deliberately slow.
SARVAM_TTS_PACE=0.7

# SQLite file. Created automatically on first run.
VAANI_DB_PATH=vaani.db

# Optional shared passcode gate — set this before tunneling to a public URL
# for the demo. Leave blank to run open (fine for localhost-only testing).
VAANI_BASIC_PASS=

# Separate passcode for the clinician view (/slp.html + assign/attempts APIs).
# Independent of VAANI_BASIC_PASS above — set this too, or a patient who has
# the general passcode can still browse to the SLP dashboard. Leave blank to
# run open (fine for local dev where only you can reach either page).
VAANI_SLP_PASS=
